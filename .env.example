# Server-only. None of these may ever reach a browser or mobile bundle.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Supavisor transaction-mode connection string (port 6543).
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Only for legacy projects that sign JWTs with HS256. Leave empty to use JWKS.
SUPABASE_JWT_SECRET=
# Comma-separated origins allowed to call the API from a browser. The site reaches the API
# server-side, so production can leave this empty.
ALLOWED_ORIGINS=http://localhost:3000
# Production: https://hongmung.com (auth emails and redirects are checked against this)
WEB_URL=http://localhost:3000
# Shared with apps/web so the API can trust the forwarded client IP for rate limiting.
INTERNAL_PROXY_SECRET=
# Protects POST /api/v1/internal/expire. Send as "Authorization: Bearer <secret>".
CRON_SECRET=
# Set to "true" to deliver push notifications through Expo.
EXPO_PUSH_ENABLED=false
